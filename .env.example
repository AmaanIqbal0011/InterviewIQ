# Copy this file to `.env.local` and fill in the public Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Resume parsing — server only. Never prefix these with NEXT_PUBLIC_.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
RESUME_LLM_PROVIDER=gemini
RESUME_LLM_MODEL=gemini-2.5-flash
RESUME_LLM_TIMEOUT_MS=30000
